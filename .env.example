# Copy to .env.local and fill in. Never commit .env.local.

# Random secret used to sign login sessions (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Who may sign in: comma-separated name:password pairs (use long, unique passwords)
DASHBOARD_USERS=admin:change-me,finance:change-me-too
